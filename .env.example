# API
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Inventory
INVENTORY_PREFER_SHEETS=true
INVENTORY_FALLBACK_PATH=database/sports_shopping_cart_product_catalog.csv
INVENTORY_DATA_DIR=data
INVENTORY_REFRESH_MS=900000

# Google Sheets — demo spreadsheet
# https://docs.google.com/spreadsheets/d/1XD6e2f_IQ1hvBn7Mq92H0AtRdcSX7_A67x0mDG6GyBk/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1XD6e2f_IQ1hvBn7Mq92H0AtRdcSX7_A67x0mDG6GyBk
GOOGLE_SHEETS_RANGE=Sheet1!A:U

# Optional service account (otherwise public CSV export is used)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Stitch — required to export design screens as PNG
# Get a key from Google AI Studio / Stitch settings, then run:
#   npx tsx scripts/fetch-stitch-screens.mts
STITCH_API_KEY=

# Feature flags
MOCK_PAYMENTS=true

# Frontend → Backend URL (only needed in production when deployed separately)
# In dev, Vite proxy handles /api → localhost:4000
# VITE_API_BASE_URL=https://sports-mart-api.vercel.app

# Supabase Auth (apps/web) — Project Settings → API
# Run SQL: supabase/migrations/001_auth_profiles_preferences.sql
# Auth → URL Configuration: Site URL http://localhost:5173
# Redirects: http://localhost:5173/** , /auth/callback , /reset-password
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
