{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd ../.. && npm run build:shared && cd apps/web && npx vite build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
