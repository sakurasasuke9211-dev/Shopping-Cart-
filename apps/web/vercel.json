{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd ../.. && npm run build:shared && cd apps/web && npx vite build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shopping-cart-api-steel.vercel.app/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
